{
  "name": "icloud-frame-sync",
  "version": "1.470.0",
  "description": "Sync iCloud Photos albums to Samsung Frame TV art display",
  "main": "dist/app.js",
  "author": "",
  "license": "MIT",
  "module": "dist/app.js",
  "type": "module",
  "bin": {
    "icloud-frame-sync": "./bin/icloud-frame-sync.js"
  },
  "scripts": {
    "dev": "tsx ./src/app.ts",
    "dev:web": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx ./src/web-app.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "vite build",
    "start": "node ./dist/app.js",
    "start:web": "node ./dist/web-app.js",
    "start:deno": "deno run --allow-read --allow-write --allow-net --allow-env --allow-sys --allow-run --unstable --watch src/app.ts",
    "lint": "eslint --fix --quiet src/**/*.ts",
    "format": "prettier --loglevel silent --write src/**/*.ts",
    "test": "mocha --require tsx/cjs --recursive 'test/**/*.test.ts'",
    "test:watch": "mocha --require tsx/cjs --recursive 'test/**/*.test.ts' --watch",
    "test:coverage": "nyc mocha --require tsx/cjs --recursive 'test/**/*.test.ts'",
    "test:unit": "mocha --require tsx/cjs --recursive 'test/unit/**/*.test.ts'",
    "test:integration": "mocha --require tsx/cjs --recursive 'test/integration/**/*.test.ts'",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.65.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/lab": "9.0.0-beta.3",
    "@mui/material": "^9.0.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "exif": "^0.6.0",
    "exif-parser": "^0.1.12",
    "exif-reader": "^2.0.3",
    "express": "^5.2.1",
    "icloudjs": "1.6.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.16.0",
    "react-window": "^2.2.7",
    "samsung-frame-connect": "github:pradeepmouli/samsung-frame-connect#add-getThumbnail-method",
    "sharp": "^0.34.5",
    "vite": "^8.0.16",
    "zod": "^4.4.3",
    "zod-express-middleware": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@to-skills/cli": "^0.3.14",
    "@types/chai": "^5.2.3",
    "@types/exif": "^0.6.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/node-fetch": "^2.6.13",
    "@types/sharp": "^0.32.0",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.0",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "chai": "^6.2.2",
    "deno": "^2.8.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "prettier": "^3.8.3",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "typescript-eslint-parser": "^22.0.0",
    "vitest": "^4.1.8"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pradeepmouli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/iCloud-Frame-Sync.git"
  }
}
